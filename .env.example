OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
EXPO_PUBLIC_ASSISTANT_API_URL=
# Public identifiers only. Never put a service-role key in an Expo variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public invitation landing URL, e.g. https://your-domain/api/invite
EXPO_PUBLIC_INVITE_URL=
# Vercel only, once the app is available. No purchase/subscription is created by code.
APP_STORE_URL=
