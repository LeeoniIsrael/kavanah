OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
EXPO_PUBLIC_ASSISTANT_API_URL=
# Public identifiers only. Never put a service-role key in an Expo variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable optional buttons only after their Supabase Auth providers and redirect URLs work.
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false
EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN=false
EXPO_PUBLIC_ENABLE_PHONE_SIGN_IN=false
# Allow kavanah://auth as a redirect URL when enabling Google.
# Public invitation landing URL, e.g. https://your-domain/api/invite
EXPO_PUBLIC_INVITE_URL=
# Vercel only, once the app is available. No purchase/subscription is created by code.
APP_STORE_URL=
