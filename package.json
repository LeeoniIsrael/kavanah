{
  "name": "kavanah",
  "version": "0.2.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "prayers:index": "tsx scripts/generateLiturgyIndex.ts",
    "prayers:review": "tsx scripts/generateHebrewReviewPacket.ts",
    "prayers:source": "tsx scripts/sourceHebrewCandidates.ts",
    "test:ui": "jest --config jest.ui.config.cjs --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-constants$": "<rootDir>/src/test/expoConstantsMock.ts",
      "^expo-crypto$": "<rootDir>/src/test/expoCryptoMock.ts",
      "^expo-haptics$": "<rootDir>/src/test/expoHapticsMock.ts",
      "^expo-secure-store$": "<rootDir>/src/test/expoSecureStoreMock.ts",
      "^hebrew-transliteration$": "<rootDir>/src/test/hebrewTransliterationMock.ts",
      "^react-native-mmkv$": "<rootDir>/src/test/mmkvMock.ts"
    }
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/noto-sans-hebrew": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@shopify/react-native-skia": "2.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "hebrew-transliteration": "^2.10.1",
    "kosher-zmanim": "^0.9.0",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-easing-gradient": "^1.1.1",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.0.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
}
