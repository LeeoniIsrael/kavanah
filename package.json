{
  "name": "kavanah",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "prayers:index": "tsx scripts/generateLiturgyIndex.ts",
    "prayers:review": "tsx scripts/generateHebrewReviewPacket.ts",
    "prayers:source": "tsx scripts/sourceHebrewCandidates.ts",
    "test:ui": "jest --config jest.ui.config.cjs --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules\\.broken-",
      "<rootDir>/node_modules\\.stale-"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-constants$": "<rootDir>/src/test/expoConstantsMock.ts",
      "^expo-crypto$": "<rootDir>/src/test/expoCryptoMock.ts",
      "^expo-haptics$": "<rootDir>/src/test/expoHapticsMock.ts",
      "^expo-secure-store$": "<rootDir>/src/test/expoSecureStoreMock.ts",
      "^hebrew-transliteration$": "<rootDir>/src/test/hebrewTransliterationMock.ts",
      "^react-native-mmkv$": "<rootDir>/src/test/mmkvMock.ts",
      "^expo-file-system$": "<rootDir>/src/test/expoFileSystemMock.ts"
    }
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/noto-sans-hebrew": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@shopify/react-native-skia": "2.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.0",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "hebrew-transliteration": "^2.10.1",
    "kosher-zmanim": "^0.9.0",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-easing-gradient": "^1.1.1",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2",
    "expo-file-system": "~57.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.0.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
