{
  "expo": {
    "name": "Kavanah",
    "slug": "kavanah",
    "scheme": "kavanah",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leeoniisrael.kavanah",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kavanah can lock your spiritual profile behind Face ID when you enable biometric lock.",
        "NSLocationWhenInUseUsageDescription": "Kavanah uses your location to calculate local zmanim and Shabbat times."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.leeoniisrael.kavanah",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kavanah uses your location to calculate local zmanim."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111827"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to create a story image. Kavanah never uploads it.",
          "cameraPermission": "Take a photo for your practice story. Kavanah never uploads it.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Kavanah only needs photo access to save a Siddur page you choose.",
          "savePhotosPermission": "Allow Kavanah to save a Siddur page image to Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "extra": {
      "assistantApiUrl": "https://kavanah-rho.vercel.app/api/assistant",
      "privacyPolicyUrl": "https://github.com/LeeoniIsrael/kavanah/blob/main/docs/privacy-policy.md",
      "termsUrl": "https://github.com/LeeoniIsrael/kavanah/blob/main/docs/terms-of-use.md",
      "supportUrl": "https://github.com/LeeoniIsrael/kavanah/issues",
      "eas": {
        "projectId": "8763a342-4956-4e23-a92e-16e457e8294f"
      }
    },
    "owner": "leeoniisrael"
  }
}
