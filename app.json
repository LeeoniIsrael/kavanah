{
  "expo": {
    "name": "Kavanah",
    "slug": "kavanah",
    "scheme": "kavanah",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leeoniisrael.kavanah",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kavanah can lock your spiritual profile behind Face ID when you enable biometric lock.",
        "NSLocationWhenInUseUsageDescription": "Kavanah uses your location to calculate local zmanim and Shabbat times."
      }
    },
    "android": {
      "package": "com.leeoniisrael.kavanah",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC"
      ]
    },
    "plugins": [
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kavanah uses your location to calculate local zmanim."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111827"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "assistantApiUrl": "https://kavanah-rho.vercel.app/api/assistant",
      "privacyPolicyUrl": "https://github.com/LeeoniIsrael/kavanah/blob/main/docs/privacy-policy.md",
      "termsUrl": "https://github.com/LeeoniIsrael/kavanah/blob/main/docs/terms-of-use.md",
      "supportUrl": "https://github.com/LeeoniIsrael/kavanah/issues"
    }
  }
}
